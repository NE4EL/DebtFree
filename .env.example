# Скопируйте в .env:  cp .env.example .env  — и замените значения ниже.
# Сгенерировать секреты:  openssl rand -hex 32
# Используйте только латинские буквы и цифры: пароль подставляется в URL подключения.

# Пароль пользователя PostgreSQL
POSTGRES_PASSWORD=change-me-db-password

# Секрет для подписи токенов входа (не короче 32 символов)
JWT_SECRET=change-me-to-64-hex-chars-from-openssl-rand-hex-32

# Порт, на котором откроется приложение: http://localhost:8080
APP_PORT=8080

# Необязательные параметры
# POSTGRES_USER=debtfree
# POSTGRES_DB=debtfree
# JWT_EXPIRE_MINUTES=1440
# DOCS_ENABLED=true        # Swagger UI на /docs; false — отключить
# WEB_CONCURRENCY=2        # число процессов backend
